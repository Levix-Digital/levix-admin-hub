# Admin Hub container image (compact profile).
# Build from the repository root: docker build -f deploy/Containerfile -t levix-hub .

# The web console is built in its own stage on Debian trixie: trunk and the wasm-bindgen and
# wasm-opt binaries it downloads need a newer glibc on aarch64 than bookworm has. The console is
# WebAssembly and static files, so the stage's glibc does not reach the image.
FROM docker.io/library/rust:1.97-trixie AS console
ARG TRUNK_VERSION=v0.22.1
ARG TRUNK_SHA256_X86_64=2ab8d548fd5ed9cda50906f61fd8654204e7893bd52ebbfd90533862b7d71ee1
ARG TRUNK_SHA256_AARCH64=b4017d1e0bfcffb4f4bee2be37c48def21e6e6896c3d0f503c43c42f714e57ea
RUN arch="$(uname -m)" \
    && case "$arch" in x86_64) sum="$TRUNK_SHA256_X86_64" ;; aarch64) sum="$TRUNK_SHA256_AARCH64" ;; *) exit 1 ;; esac \
    && curl -sSfL -o /tmp/trunk.tar.gz "https://github.com/trunk-rs/trunk/releases/download/${TRUNK_VERSION}/trunk-${arch}-unknown-linux-gnu.tar.gz" \
    && echo "${sum}  /tmp/trunk.tar.gz" | sha256sum -c \
    && tar xzf /tmp/trunk.tar.gz -C /usr/local/bin trunk
WORKDIR /src
COPY . .
RUN cd crates/hub-console && trunk build --release --locked

# The server is built on bookworm, the Debian release of the runtime image, and embeds the console.
FROM docker.io/library/rust:1.97-bookworm AS build
WORKDIR /src
COPY . .
COPY --from=console /src/crates/hub-console/dist crates/hub-console/dist
RUN cargo build --release --locked -p hub-server \
    && install -D -m 0755 target/release/levix-hub /out/usr/local/bin/levix-hub \
    && install -d -m 0700 /out/var/lib/levix-hub

FROM gcr.io/distroless/cc-debian12:nonroot
COPY --from=build /out/usr/local/bin/levix-hub /usr/local/bin/levix-hub
COPY --from=build --chown=nonroot:nonroot /out/var/lib/levix-hub /var/lib/levix-hub
USER nonroot:nonroot
ENV LEVIX_HUB_DATA_DIR=/var/lib/levix-hub \
    LEVIX_HUB_LISTEN=0.0.0.0:8443
VOLUME ["/var/lib/levix-hub"]
EXPOSE 8443
ENTRYPOINT ["/usr/local/bin/levix-hub"]
CMD ["serve"]
