# Tool settings: the shared settings file that turns attribution off and the link to the
# project skills (.agents/skills) are committed; personal settings are not.
.claude/*
!.claude/settings.json
!.claude/skills

# Spec Kit files that are per-machine. The integration (agy, skills in .agents/skills) is shared.
.specify/extensions/.registry
.specify/workflows/speckit/
.specify/presets/dev-cycle/compat.json

# Build output.
/target/
crates/hub-console/dist/
*.cdx.json
