{
  "project_name": "levix-admin-hub",
  "docs": {
    "user_doc": "README.md"
  },
  "devops": {
    "branching": "trunk",
    "production_branch": "main",
    "version_files": [
      "Cargo.toml"
    ]
  },
  "architecture": {
    "style": "hexagonal",
    "core_path": "crates/hub-core",
    "surfaces": [
      "api",
      "channel",
      "console",
      "cli"
    ],
    "canonical_datastore": "SQLite (compact profile) or PostgreSQL (scalable profile), one database per Hub",
    "forbidden_core_imports": [
      "axum",
      "sqlx",
      "leptos",
      "redis",
      "tokio_tungstenite",
      "reqwest",
      "hub_api",
      "hub_channel",
      "hub_console",
      "hub_cli"
    ]
  },
  "speckit": {
    "enabled": true,
    "version": "v1.2.3",
    "script": "sh",
    "branch_prefix": "feat"
  },
  "test_commands": [
    "cargo fmt --all --check",
    "cargo clippy --workspace --all-targets --locked -- -D warnings",
    "cargo test --workspace --locked"
  ]
}
